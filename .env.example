# ==============================================================================
# Raggae Configuration
# Serverless Free-Tier Hybrid RAG Engine on Supabase Edge & pgvector
# ==============================================================================

# 1. Supabase Project Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Free Vector Embeddings via Google AI Studio
# Gemini text-embedding-004 (768-dim, 100% free tier: up to 1,500 req/min)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy...

# Optional: Fallback Embedding Provider (OpenAI text-embedding-3-small)
OPENAI_API_KEY=sk-...

# 3. Rate Control & Free-Tier Budgeting Settings
# Keeps transactions strictly within Supabase & Gemini free tier limits
RAGGAE_TPS=1.5
RAGGAE_BATCH_SIZE=25
RAGGAE_CHUNK_SIZE=1000
RAGGAE_CHUNK_OVERLAP=150
RAGGAE_COLLECTION=default
